   "source": [
    "## 14. Model and Artifact Saving\n",
    "Saving model, scaler, encoder, and metrics.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "a579745b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Saved Linear Regression artifacts to C:\\Users\\MAHIR\\OneDrive\\Documents\\BMU\\ACADEMICS\\RoadSafe-Delhi-main\\RoadSafe-Delhi-main\\models\\linear_regression\\artifacts\n"
     ]
    }
   ],
   "source": [
    "import joblib\n",
    "\n",
    "joblib.dump(lr_model, os.path.join(ARTIFACTS_DIR, \"linear_regression_model.joblib\"))\n",
